{
  "name": "php-ai/structured-outputs2",
  "description": "A PHP application for generating structured outputs and HTML conversion using OpenAI",
  "require": {
    "php": "^8.1",
    "openai-php/client": "^0.8.0",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.5",
    "symfony/http-foundation": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
